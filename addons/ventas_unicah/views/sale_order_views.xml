<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario del pedido -->
    <record id="view_order_form_ventas_unicah" model="ir.ui.view">
        <field name="name">sale.order.form.ventas.unicah</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_aprobar"
                        string="Aprobar"
                        type="object"
                        class="btn-primary"
                        groups="sales_team.group_sale_manager"
                        invisible="not pendiente_aprobacion"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not pendiente_aprobacion">
                    Este pedido supera el monto permitido y necesita la
                    aprobación de un administrador de ventas.
                </div>
            </xpath>
            <xpath expr="//group[@name='partner_details']" position="inside">
                <field name="canal_venta"/>
                <field name="total_unidades"/>
                <field name="pendiente_aprobacion" invisible="1"/>
                <field name="aprobado_por" invisible="not aprobado_por"/>
            </xpath>
        </field>
    </record>

    <!-- Lista de cotizaciones y pedidos -->
    <record id="sale_order_tree_ventas_unicah" model="ir.ui.view">
        <field name="name">sale.order.list.ventas.unicah</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="canal_venta" optional="show"/>
                <field name="total_unidades" optional="show" sum="Total"/>
            </field>
        </field>
    </record>

    <!-- Búsqueda, filtros y agrupaciones -->
    <record id="view_sales_order_filter_ventas_unicah" model="ir.ui.view">
        <field name="name">sale.order.search.ventas.unicah</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="canal_venta"/>
            </field>
            <xpath expr="//search/group" position="before">
                <separator/>
                <filter name="requiere_aprobacion"
                        string="Requiere aprobación"
                        domain="[('requiere_aprobacion', '=', True)]"/>
                <separator/>
                <filter name="canal_tienda" string="Tienda" domain="[('canal_venta', '=', 'tienda')]"/>
                <filter name="canal_telefono" string="Teléfono" domain="[('canal_venta', '=', 'telefono')]"/>
                <filter name="canal_web" string="Sitio web" domain="[('canal_venta', '=', 'web')]"/>
                <filter name="canal_distribuidor" string="Distribuidor" domain="[('canal_venta', '=', 'distribuidor')]"/>
            </xpath>
            <filter name="customer" position="after">
                <filter name="agrupar_canal"
                        string="Canal de venta"
                        context="{'group_by': 'canal_venta'}"/>
            </filter>
        </field>
    </record>
</odoo>
